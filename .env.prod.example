# RMMWay production environment (A-1).
#
#   cp .env.prod.example .env.prod
#   # fill in the REQUIRED secrets below, then:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#   # (or: make prod)
#
# .env.prod is git-ignored — it holds real secrets.

# ---- public identity -------------------------------------------------------
# The hostname operators + agents use. A real DNS name (A/AAAA record ->
# this host's public IP) is strongly recommended: Caddy then provisions
# Let's Encrypt automatically (HTTP-01). "localhost" uses Caddy's internal
# CA and is for local bring-up only. (Caddy >= 2.8 can also issue LE certs
# for a bare public IP address.)
 RMMWAY_DOMAIN=localhost

# Optional: explicit SANs for the mTLS server cert (comma-separated DNS
# names / IPs). Defaults to RMMWAY_DOMAIN. Set it when your agents dial an
# address different from RMMWAY_DOMAIN — e.g. the host's LAN IP:
# RMMWAY_GRPC_MTLS_SANs=203.0.113.10

# Let's Encrypt account email (expiry notices only). Optional.
RMMWAY_ACME_EMAIL=admin@example.com

# The ONLY host port agents need (besides the operator origin on 443/80).
# Agents enroll over the operator's HTTPS origin (POST /agent/enroll) and then
# stream over this mTLS gRPC port. The plain gRPC bootstrap port (50051) stays
# internal — a remote device only needs the server host + this port open.
RMMWAY_AGENT_MTLS_PORT=50052

# ---- REQUIRED secrets (generate each with: openssl rand -hex 32) -----------
# Signs operator JWTs + capability tokens.
RMMWAY_JWT_SECRET=

# Postgres/Timescale superuser password for this stack.
RMMWAY_PG_PASSWORD=

# Meilisearch master key.
RMMWAY_MEILI_MASTER_KEY=

# MinIO root password.
RMMWAY_MINIO_PASSWORD=

# Env fallback / break-glass operator admin (A-2). The PRIMARY root admin is
# minted by the first-boot setup wizard (see README "First-boot setup wizard");
# this env account stays as a known, strong out-of-band login. Set it to a
# strong secret distinct from the wizard password.
RMMWAY_ADMIN_PASSWORD=

# ---- optional overrides ------------------------------------------------------
# Boot-time env (C2): "dev" allows the built-in dev defaults; any other value
# makes the server refuse to boot while a default JWT secret / admin creds /
# Meili master key is in play. Set it explicitly so prod is prod on purpose.
RMMWAY_ENV=prod

# Image tag stamped into the built server/frontend images.
RMMWAY_VERSION=0.1.0

# Postgres user (default rmmway), admin login (default admin), MinIO user
# (default rmmway).
RMMWAY_PG_USER=rmmway
RMMWAY_ADMIN_USER=admin
RMMWAY_MINIO_USER=rmmway

# Bring-your-own reverse proxy (A-1). Only used by the BYO flow
# (`make prod-byoproxy`, i.e. the base file + docker-compose.byoproxy.yml with
# the bundled Caddy "edge" profile off). They set the HOST ports your proxy
# forwards to. SIMPLEST: point your whole proxy at the SPA port — the frontend
# serves the SPA and proxies /api, /agent and /healthz to the backend:
#   everything                  ->  localhost:RMMWAY_FRONTEND_PORT
# OPTIONAL: route /api straight to the backend instead (skip the frontend hop):
#   /api/*  /agent/*  /healthz* ->  localhost:RMMWAY_HTTP_PORT
# Leave unset to use the defaults (8080 / 8081).
RMMWAY_HTTP_PORT=8080
RMMWAY_FRONTEND_PORT=8081
