# RMMWay production environment (A-1).
#
#   cp .env.prod.example .env.prod
#   # fill in the REQUIRED secrets below, then:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#   # (or: make prod)
#
# .env.prod is git-ignored — it holds real secrets.

# ---- public identity -------------------------------------------------------
# The hostname operators + agents use. A real DNS name (A/AAAA record ->
# this host's public IP) is strongly recommended: Caddy then provisions
# Let's Encrypt automatically (HTTP-01). "localhost" uses Caddy's internal
# CA and is for local bring-up only. (Caddy >= 2.8 can also issue LE certs
# for a bare public IP address.)
RMMWAY_DOMAIN=localhost

# Let's Encrypt account email (expiry notices only). Optional.
RMMWAY_ACME_EMAIL=admin@example.com

# Host port for the mTLS gRPC agent channel (Caddy L4 passthrough).
RMMWAY_AGENT_MTLS_PORT=50052

# ---- REQUIRED secrets (generate each with: openssl rand -hex 32) -----------
# Signs operator JWTs + capability tokens.
RMMWAY_JWT_SECRET=

# Postgres/Timescale superuser password for this stack.
RMMWAY_PG_PASSWORD=

# Meilisearch master key.
RMMWAY_MEILI_MASTER_KEY=

# MinIO root password.
RMMWAY_MINIO_PASSWORD=

# Operator (admin) login password for the frontend.
RMMWAY_ADMIN_PASSWORD=

# ---- optional overrides ------------------------------------------------------
# Image tag stamped into the built server/frontend images.
RMMWAY_VERSION=0.1.0

# Postgres user (default rmmway), admin login (default admin), MinIO user
# (default rmmway).
RMMWAY_PG_USER=rmmway
RMMWAY_ADMIN_USER=admin
RMMWAY_MINIO_USER=rmmway
